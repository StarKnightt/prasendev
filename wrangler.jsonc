{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "prasendev",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // R2 incremental cache: makes time-based ISR revalidation work at runtime
  // (the previous static-assets cache was read-only, so ISR data was frozen
  // at build time until the next deploy).
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "prasendev-cache"
    }
  ],
  // Required by the memory queue to send revalidation requests to ourselves.
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "prasendev"
    }
  ],
  // v1 created the DO revalidation queue; v2 deletes it (and its stored
  // state) after the switch to the memory queue — see open-next.config.ts.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"]
    },
    {
      "tag": "v2",
      "deleted_classes": ["DOQueueHandler"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
